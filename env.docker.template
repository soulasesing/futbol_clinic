# ==============================================
# DOCKER PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env for Docker deployment

# Database Configuration
POSTGRES_DB=futbol_clinic
POSTGRES_ADMIN_USER=futbol_migrator
POSTGRES_ADMIN_PASSWORD=replace-with-a-random-admin-database-password
APP_DB_USER=futbol_app
APP_DB_PASSWORD=replace-with-a-different-random-app-password
MIGRATOR_DATABASE_URL=postgresql://futbol_migrator:replace-with-a-random-admin-database-password@database:5432/futbol_clinic
DATABASE_URL=postgresql://futbol_app:replace-with-a-different-random-app-password@database:5432/futbol_clinic

# JWT Configuration - generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Public HTTPS URLs
FRONTEND_URL=https://app.example.com
BACKEND_URL=https://api.example.com

# Docker Environment Flag
DOCKER_ENV=true

# File Storage - leave empty for local-only development
BLOB_READ_WRITE_TOKEN=
# Use a separate private Vercel Blob store for documents and payment proofs.
PRIVATE_BLOB_READ_WRITE_TOKEN=

# Email Configuration (Optional)
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-password

# Node Environment
NODE_ENV=production

# Database Connection Pool Settings
DATABASE_MAX_CONNECTIONS=20
DATABASE_IDLE_TIMEOUT=30000
DATABASE_CONNECTION_TIMEOUT=10000

# Ports
PORT=4000
NEXT_PORT=3000
