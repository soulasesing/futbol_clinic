{
  "name": "futbol-clinic-backend",
  "version": "1.0.0",
  "description": "API RESTful multi-tenant para escuelas de fútbol",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "yarn build && jest --runInBand",
    "migrate": "yarn build && node dist/scripts/migrate.js",
    "create-super-admin": "yarn build && node dist/scripts/createSuperAdmin.js",
    "seed-demo": "yarn build && node dist/scripts/seedDemo.js",
    "provision-pachuca": "yarn build && node dist/scripts/provisionPachuca.js",
    "vercel-build": "tsc"
  },
  "dependencies": {
    "@vercel/blob": "^2.6.1",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.11",
    "pg": "^8.11.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.15.4",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.4"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
